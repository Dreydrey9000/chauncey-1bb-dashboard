data: {"result":{"content":[{"type":"text","text":"{\n  \"status\": \"partial\",\n  \"username\": \"rowancheung\",\n  \"posts\": [\n    {\n      \"id\": \"3917417486894129922\",\n      \"shortcode\": \"DZddnLvOmMC\",\n      \"url\": \"https://www.instagram.com/reel/DZddnLvOmMC/\",\n      \"type\": \"video\",\n      \"caption\": \"Hiroki Tomiyasu, a broccoli farmer in Hokkaido, Japan, has automated much of his 100-hectare operation using ChatGPT and Codex, despite having no background in engineering or agriculture.\\n\\nA former public servant who taught himself to farm, Tomiyasu uses AI to diagnose crop diseases from photos, bui...\",\n      \"duration\": null,\n      \"timestamp\": \"2026-06-11T21:18:22.000Z\",\n      \"stats\": {\n        \"views\": 1297973,\n        \"likes\": 90717,\n        \"comments\": 336,\n        \"shares\": null,\n        \"reposts\": null\n      }\n    },\n    {\n      \"id\": \"3740496293924505933\",\n      \"shortcode\": \"DPo6Y-zCQlN\",\n      \"url\": \"https://www.instagram.com/reel/DPo6Y-zCQlN/\",\n      \"type\": \"video\",\n      \"caption\": \"Sam Altman on Sora and why OpenAI releases AI video tools early, even with risks of deepfakes and watermark removal. Watch the full interview with Sam on my YouTube (link in story!)\\n\\n#trendingreels #ai #sora\",\n      \"duration\": null,\n      \"timestamp\": \"2025-10-10T18:51:48.000Z\",\n      \"stats\": {\n        \"views\": 681203,\n        \"likes\": 6845,\n        \"comments\": 1287,\n        \"shares\": null,\n        \"reposts\": null\n      }\n    },\n    {\n      \"id\": \"3724007409128934608\",\n      \"shortcode\": \"DOuVQIKDYzQ\",\n      \"url\": \"https://www.instagram.com/reel/DOuVQIKDYzQ/\",\n      \"type\": \"video\",\n      \"caption\": \"I sat down with @zuck to chat through Meta’s latest AI-powered glasses revealed at Connect 2025.\\n\\nThe Ray-Ban Displays paired with the Neural Band introduce a whole new computing interface by using EMG tech to detect neural input